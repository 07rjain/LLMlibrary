ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
GEMINI_API_KEY=
DATABASE_URL=

# Optional live-test model overrides. LIVE_* takes precedence over LIVE_REAL_*.
# Generic LIVE_TESTS / LIVE_CONFORMANCE defaults:
LIVE_OPENAI_MODEL=
LIVE_ANTHROPIC_MODEL=
LIVE_GEMINI_MODEL=
# Existing LIVE_REAL_* suites remain compatible with these aliases.
LIVE_REAL_OPENAI_MODEL=
LIVE_REAL_ANTHROPIC_MODEL=
LIVE_REAL_GEMINI_MODEL=
# Opt-in OpenAI speech smoke test (requires LIVE_REAL_TESTS=1 and LIVE_REAL_SPEECH=1).
LIVE_REAL_SPEECH=0
LIVE_REAL_OPENAI_TTS_MODEL=gpt-4o-mini-tts
LIVE_REAL_OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Capability-specific Gemini reasoning/cache fixtures intentionally stay separate.
LIVE_REAL_GEMINI_THINKING_MODEL=gemini-2.5-flash
