LIVE_REAL_ANTHROPIC_MODEL=
LIVE_REAL_GEMINI_MODEL=
# Capability-specific Gemini reasoning/cache fixtures intentionally stay separate.
LIVE_REAL_GEMINI_THINKING_MODEL=gemini-2.5-flash
